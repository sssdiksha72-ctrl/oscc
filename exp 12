Practical No: 12
Aim: Disk Scheduling Algorithms – Implement FCFS, SSTF, SCAN, and C-SCAN disk scheduling in C/Python.

Theory:
FCFS (First Come, First Served): Requests are serviced in the order they arrive.
SSTF (Shortest Seek Time First): The request closest to the current head position is serviced first.
SCAN: The disk head moves in one direction, services requests along the way, reaches the disk end, and then reverses direction.
C-SCAN (Circular SCAN): The head moves in one direction to the disk end, jumps to the beginning, and continues in the same direction.

Code:
#include <stdio.h>
#include <stdlib.h>

int main()
{
    int a[] = {82, 170, 43, 140, 24, 16, 190};
    int n = 7, head = 50, i, j, temp;
    int pos, total;

    // FCFS
    pos = head;
    total = 0;

    for (i = 0; i < n; i++)
    {
        total += abs(a[i] - pos);
        pos = a[i];
    }
    printf("FCFS = %d\n", total);

    // Sort requests for other algorithms
    for (i = 0; i < n - 1; i++)
        for (j = i + 1; j < n; j++)
            if (a[i] > a[j])
            {
                temp = a[i];
                a[i] = a[j];
                a[j] = temp;
            }

    // SSTF
    int b[] = {82, 170, 43, 140, 24, 16, 190};
    int used[7] = {0};
    pos = head;
    total = 0;

    for (i = 0; i < n; i++)
    {
        int min = 9999, k = -1;

        for (j = 0; j < n; j++)
            if (!used[j] && abs(b[j] - pos) < min)
            {
                min = abs(b[j] - pos);
                k = j;
            }

        total += min;
        pos = b[k];
        used[k] = 1;
    }
    printf("SSTF = %d\n", total);

    // SCAN (move towards 199 first)
    pos = head;
    total = 0;

    for (i = 0; i < n; i++)
        if (a[i] >= head)
        {
            total += abs(a[i] - pos);
            pos = a[i];
        }

    total += abs(199 - pos);
    pos = 199;

    for (i = n - 1; i >= 0; i--)
        if (a[i] < head)
        {
            total += abs(a[i] - pos);
            pos = a[i];
        }
    printf("SCAN = %d\n", total);

    // C-SCAN (move towards 199 first)
    pos = head;
    total = 0;

    for (i = 0; i < n; i++)
        if (a[i] >= head)
        {
            total += abs(a[i] - pos);
            pos = a[i];
        }

    total += abs(199 - pos);
    total += 199;  // Jump from 199 to 0
    pos = 0;

    for (i = 0; i < n; i++)
        if (a[i] < head)
        {
            total += abs(a[i] - pos);
            pos = a[i];
        }
    printf("C-SCAN = %d\n", total);

    return 0;
}

