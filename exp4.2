2.SJF (Shortest Job First) C Program :- SJF selects the process having the shortest burst time.
Code:-
#include <stdio.h>
int main()
{
    int n, i, j, temp; //temp =Temporarily stores a value during swapping
    int bt[20], wt[20], tat[20], p[20];

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("Enter burst time for each process:\n");

    for(i = 0; i < n; i++)
    {
        p[i] = i + 1;

        printf("P%d: ", i + 1);
        scanf("%d", &bt[i]);
    }
    // Sort processes according to burst time
    for(i = 0; i < n - 1; i++)
    {
        for(j = i + 1; j < n; j++)
        {
            if(bt[i] > bt[j])
            {
                temp = bt[i];
                bt[i] = bt[j];
                bt[j] = temp;
                // Swap process numbers also
                temp = p[i];
                p[i] = p[j];
                p[j] = temp;
            }
        }
    }
    // Waiting time
    wt[0] = 0;

    for(i = 1; i < n; i++)
    {
        wt[i] = wt[i - 1] + bt[i - 1];
    }
    // Turnaround time
    for(i = 0; i < n; i++)
    {
        tat[i] = wt[i] + bt[i];
    }
    printf("\nProcess\tBT\tWT\tTAT\n");

    for(i = 0; i < n; i++)
    {
        printf("P%d\t%d\t%d\t%d\n",
               p[i], bt[i], wt[i], tat[i]);
    }
    return 0;
}
