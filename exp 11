Aim: · File System Simulation – Implement a simple file system in C/Python with file creation, deletion, and searching.
Theory:
A file system is a component of an operating system that manages files and directories. It allows users to create, store, search, access, and delete files.
This program simulates a simple file system using a two-dimensional character array.
•	Create: Adds a new filename to the list.
•	Delete: Removes a filename from the list.
•	Search: Checks whether a filename exists.

Code:
#include <stdio.h>
#include <string.h>

int main()
{
    char files[10][20];
    char name[20];
    int count = 0, choice, i, found;

    printf("1. Create File\n");
    printf("2. Search File\n");
    printf("3. Delete File\n");
    printf("Enter choice: ");
    scanf("%d", &choice);

    if (choice == 1)
    {
        printf("Enter file name: ");
        scanf("%19s", name);

        strcpy(files[count], name);
        count++;

        printf("File created successfully\n");
    }
    else if (choice == 2)
    {
        printf("Enter file name: ");
        scanf("%19s", name);

        found = 0;
        for (i = 0; i < count; i++)
        {
            if (strcmp(files[i], name) == 0)
                found = 1;
        }

        if (found == 1)
            printf("File found\n");
        else
            printf("File not found\n");
    }
    else if (choice == 3)
    {
        printf("Enter file name: ");
        scanf("%19s", name);

        found = 0;
        for (i = 0; i < count; i++)
        {
            if (strcmp(files[i], name) == 0)
            {
                strcpy(files[i], files[count - 1]);
                count--;
                found = 1;
                printf("File deleted successfully\n");
                break;
            }
        }

        if (found == 0)
            printf("File not found\n");
    }
    else
    {
        printf("Invalid choice\n");
    }

    return 0;
}

