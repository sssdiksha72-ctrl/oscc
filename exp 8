Aim: Page Replacement Algorithm Implementation – Implement FIFO, LRU, and Optimal page replacement in Python/C.

Theory:
•	FIFO (First In, First Out): The page that entered memory first is removed first.
•	LRU (Least Recently Used): The page that has not been used for the longest time is removed.
•	Optimal Page Replacement: The page that will not be used for the longest time in the future is removed.

Important terms:
•	Page: A block of a program stored in memory.
•	Frame: A space in main memory that holds a page.
•	Page fault: Occurs when the required page is not present in memory.
•	Capacity: The maximum number of pages that can fit in the available frames.
 
Code:
#include <stdio.h>

int main()
{
    int pages[] = {1, 2, 3, 1, 4, 5};
    int n = 6, capacity = 3;
    int frames[3], i, j, k, faults, found;

    // FIFO Algorithm
    faults = 0;
    int pos = 0; // Position of frame 

    for (i = 0; i < capacity; i++)
        frames[i] = -1;

    for (i = 0; i < n; i++)
    {
        found = 0;

        for (j = 0; j < capacity; j++)
            if (frames[j] == pages[i])
                found = 1;

        if (found == 0)
        {
            frames[pos] = pages[i];
            pos = (pos + 1) % capacity;
            faults++;
        }
    }

    printf("FIFO Page Faults = %d\n", faults);

    // LRU Algorithm
    faults = 0;

    int time[3] = {0};

    for (i = 0; i < capacity; i++)
        frames[i] = -1;

    for (i = 0; i < n; i++)
    {
        found = 0;

        for (j = 0; j < capacity; j++)
            if (frames[j] == pages[i])
            {
                found = 1;
                time[j] = i;
            }

        if (found == 0)
        {
            pos = 0;

            for (j = 0; j < capacity; j++)
                if (frames[j] == -1)
                {
                    pos = j;
                    break;
                }

            if (frames[pos] != -1)
                for (j = 1; j < capacity; j++)
                    if (time[j] < time[pos])
                        pos = j;

            frames[pos] = pages[i];
            time[pos] = i;
            faults++;
        }
    }

    printf("LRU Page Faults = %d\n", faults);

    // Optimal Algorithm
    faults = 0;

    for (i = 0; i < capacity; i++)
        frames[i] = -1;

    for (i = 0; i < n; i++)
    {
        found = 0;

        for (j = 0; j < capacity; j++)
            if (frames[j] == pages[i])
                found = 1;

        if (found == 0)
        {
            pos = -1;
            int farthest = -1;

            for (j = 0; j < capacity; j++)
            {
                if (frames[j] == -1)
                {
                    pos = j;
                    break;
                }

                for (k = i + 1; k < n; k++)
                    if (pages[k] == frames[j])
                        break;

                if (k > farthest)
                {
                    farthest = k;
                    pos = j;
                }
            }

            frames[pos] = pages[i];
            faults++;
        }
    }

    printf("Optimal Page Faults = %d\n", faults);

    return 0;
}


Output:
FIFO Page Faults = 6
LRU Page Faults = 5
Optimal Page Faults = 5
